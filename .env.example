# Required for post-recording batch transcription (main process only).
ELEVENLABS_API_KEY=

# Optional. Enables LLM-assisted bad-take detection (main process only):
# the Remove Bad Takes button sends transcript text (never media or paths)
# to the OpenAI API to catch reworded retakes. Without it, detection falls
# back to exact word matching.
OPENAI_API_KEY=
# Optional override for the detection model (default: gpt-5.6-sol).
OPENAI_RETAKE_MODEL=
